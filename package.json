{
  "name": "s29-bots",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "npm run build && node tests/run.mjs",
    "deploy:commands": "tsx src/discord/deploy_commands.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@prometheus-io/client": "^0.16.1",
    "bullmq": "^6.3.8",
    "discord.js": "14.27.0",
    "dotenv": "^18.0.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
